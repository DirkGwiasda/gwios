@inherits LayoutComponentBase

@* data-interactive tells the end-to-end tests when the page reacts to clicks; before, it is only prerendered. *@
<div class="gwios-app" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    <div class="gwios-backdrop" aria-hidden="true">
        <div class="gwios-backdrop-gradient"></div>
        <div class="gwios-backdrop-orb gwios-backdrop-orb--blue"></div>
        <div class="gwios-backdrop-orb gwios-backdrop-orb--green"></div>
        <div class="gwios-backdrop-stars"></div>
    </div>

    <AppHeader />

    <main class="gwios-main">
        @Body
    </main>

    <GwiOSStatusBar />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>
