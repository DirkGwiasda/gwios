<div class="gwios-line-chart-legend">
    @foreach (GwiOSLineSeries series in Series)
    {
        <span class="gwios-line-chart-legend-item">
            <span class="gwios-line-chart-legend-swatch" style="background-color: @series.Color;"></span>
            @series.Label
        </span>
    }
</div>

@code {
    /// <summary>
    /// The lines of the chart the legend explains, in display order.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<GwiOSLineSeries> Series { get; set; } = [];
}
