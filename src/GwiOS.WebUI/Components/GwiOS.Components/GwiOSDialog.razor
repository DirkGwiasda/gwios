<div class="gwios-dialog-backdrop" @onclick="CloseAsync"></div>
<div class="gwios-dialog"
     role="dialog"
     aria-modal="true"
     aria-labelledby="@_titleId"
     tabindex="-1"
     @ref="_dialogElement"
     @onkeydown="OnKeyDownAsync">
    <header class="gwios-dialog-header">
        <h2 id="@_titleId" class="gwios-dialog-title">@Title</h2>
        @HeaderContent
        <button type="button"
                class="gwios-dialog-close"
                aria-label="Schließen"
                title="Schließen"
                disabled="@(!CanClose)"
                @onclick="CloseAsync">
            ✕
        </button>
    </header>
    <div class="gwios-dialog-body">
        @ChildContent
    </div>
    @if (Actions is not null)
    {
        <footer class="gwios-dialog-actions">
            @Actions
        </footer>
    }
</div>
