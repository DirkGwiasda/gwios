<span class="gwios-log-level @LevelClass @(IsLarge ? "gwios-log-level--large" : null)">@Label</span>

@code {
    /// <summary>
    /// The severity the badge shows.
    /// </summary>
    [Parameter, EditorRequired]
    public LogLevel Level { get; set; }

    /// <summary>
    /// Whether the badge is shown in a larger size, such as in the header of a dialog.
    /// </summary>
    [Parameter]
    public bool IsLarge { get; set; }

    private string Label
        => Level switch
        {
            LogLevel.Error => "Error",
            LogLevel.Warning => "Warning",
            LogLevel.Information => "Information",
            LogLevel.Debug => "Debug",
            _ => "None"
        };

    private string LevelClass
        => Level switch
        {
            LogLevel.Error => "gwios-log-level--error",
            LogLevel.Warning => "gwios-log-level--warning",
            LogLevel.Information => "gwios-log-level--information",
            _ => "gwios-log-level--debug"
        };
}
