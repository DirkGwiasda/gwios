<article class="gwios-person-tile">
    <div class="gwios-person-tile-header">
        <span class="gwios-person-avatar" aria-hidden="true">@Initials</span>
        <div class="gwios-person-names">
            <span class="gwios-person-name" title="@Person.Name">@Person.Name</span>
            <span class="gwios-person-short-name">@Person.ShortName</span>
        </div>
        <div class="gwios-person-actions">
            <button type="button"
                    class="gwios-icon-button gwios-icon-button--primary"
                    title="@($"„{Person.Name}“ bearbeiten")"
                    aria-label="@($"„{Person.Name}“ bearbeiten")"
                    @onclick="OnEdit">
                ✎
            </button>
            <GwiOSConfirmButton Title="@($"„{Person.Name}“ löschen")"
                                ConfirmText="Sicher?"
                                ConfirmTitle="Zum Bestätigen erneut klicken"
                                CssClass="gwios-icon-button"
                                ConfirmCssClass="gwios-icon-button gwios-icon-button--danger"
                                OnConfirmed="OnDelete">
                ✕
            </GwiOSConfirmButton>
        </div>
    </div>
    @if (Person.IdentityUserId is null)
    {
        <span class="gwios-badge gwios-badge--muted" title="Die Person hat kein Benutzerkonto.">kein Konto</span>
    }
    else
    {
        <span class="gwios-badge gwios-badge--success" title="Die Person meldet sich mit einem Benutzerkonto an.">Konto</span>
    }
</article>

@code {
    // The avatar shows this many characters of the short name.
    private const int InitialsLength = 2;

    /// <summary>
    /// The person the tile shows.
    /// </summary>
    [Parameter, EditorRequired]
    public Person Person { get; set; } = default!;

    /// <summary>
    /// Raised when the user clicks the edit button.
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>
    /// Raised when the user deletes the person and confirms it with a second click.
    /// </summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    private string Initials
        => InitialsSource.Length > 0
            ? InitialsSource[..Math.Min(InitialsLength, InitialsSource.Length)].ToUpperInvariant()
            : "?";

    private string InitialsSource
        => string.IsNullOrWhiteSpace(Person.ShortName) ? Person.Name.Trim() : Person.ShortName.Trim();
}
