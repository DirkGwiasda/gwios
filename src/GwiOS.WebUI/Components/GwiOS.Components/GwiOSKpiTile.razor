<div class="gwios-panel gwios-kpi-tile gwios-kpi-tile--@AccentClass">
    <span class="gwios-kpi-tile-label">@Label</span>
    <span class="gwios-kpi-tile-value">@Value</span>
    @if ((FooterLeft is not null) || (FooterRight is not null))
    {
        <div class="gwios-kpi-tile-footer">
            <span>@FooterLeft</span>
            <span class="@FooterRightClass">@FooterRight</span>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Uppercase label above the value.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>
    /// The formatted figure, e.g. an amount in euros.
    /// </summary>
    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Color of the left border and the value.
    /// </summary>
    [Parameter]
    public GwiOSKpiAccent Accent { get; set; } = GwiOSKpiAccent.Primary;

    /// <summary>
    /// Text at the left of the footer row below the value, or <c>null</c> for no footer.
    /// </summary>
    [Parameter]
    public string? FooterLeft { get; set; }

    /// <summary>
    /// Text at the right of the footer row below the value, or <c>null</c> for none.
    /// </summary>
    [Parameter]
    public string? FooterRight { get; set; }

    /// <summary>
    /// Whether <see cref="FooterRight"/> is shown as a warning instead of the muted default color.
    /// </summary>
    [Parameter]
    public bool IsFooterRightWarning { get; set; }

    private string AccentClass
        => Accent.ToString().ToLowerInvariant();

    private string FooterRightClass
        => IsFooterRightWarning ? "gwios-kpi-tile-footer-value--warning" : "gwios-kpi-tile-footer-value";
}
