<div class="gwios-kpi-tile gwios-kpi-tile--@ToClassSuffix(Accent)">
    <span class="gwios-kpi-tile-label">@Label</span>
    <span class="gwios-kpi-tile-value gwios-kpi-text--@ToClassSuffix(ValueAccent ?? Accent)">@Value</span>
    @if ((FooterLeft is not null) || (FooterRight is not null))
    {
        <div class="gwios-kpi-tile-footer">
            <span>@FooterLeft</span>
            <span class="gwios-kpi-text--@ToClassSuffix(FooterRightAccent)">@FooterRight</span>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Uppercase label above the value.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>
    /// The formatted figure, e.g. an amount in euros.
    /// </summary>
    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Color of the left border, and of the value unless <see cref="ValueAccent"/> is set.
    /// </summary>
    [Parameter]
    public GwiOSKpiAccent Accent { get; set; } = GwiOSKpiAccent.Primary;

    /// <summary>
    /// Color of the value if it differs from <see cref="Accent"/>, or <c>null</c> to use <see cref="Accent"/>.
    /// </summary>
    [Parameter]
    public GwiOSKpiAccent? ValueAccent { get; set; }

    /// <summary>
    /// Text at the left of the footer row below the value, or <c>null</c> for no footer.
    /// </summary>
    [Parameter]
    public string? FooterLeft { get; set; }

    /// <summary>
    /// Text at the right of the footer row below the value, or <c>null</c> for none.
    /// </summary>
    [Parameter]
    public string? FooterRight { get; set; }

    /// <summary>
    /// Color of <see cref="FooterRight"/>.
    /// </summary>
    [Parameter]
    public GwiOSKpiAccent FooterRightAccent { get; set; } = GwiOSKpiAccent.Muted;

    private static string ToClassSuffix(GwiOSKpiAccent accent)
        => accent.ToString().ToLowerInvariant();
}
