@page "/admin/logging"

<PageTitle>System-Logs · gwi-os</PageTitle>

<div class="gwios-page">
    <h1>System-Logs</h1>

    <div class="gwios-log-toolbar">
        <GwiOSPillGroup Items="AppChoices"
                        SelectedItem="@SelectedAppChoice"
                        SelectedItemChanged="SelectAppAsync"
                        AriaLabel="Anwendung" />
        <div class="gwios-log-actions">
            <button type="button" class="gwios-button" @onclick="ReloadEntriesAsync">Aktualisieren</button>
            @if (_selectedAppName is not null)
            {
                <GwiOSConfirmButton Title="@($"Alle Log-Einträge von „{_selectedAppName}“ löschen")"
                                    ConfirmText="Wirklich alle löschen?"
                                    OnConfirmed="DeleteEntriesAsync">
                    Einträge löschen
                </GwiOSConfirmButton>
            }
        </div>
    </div>

    <div class="gwios-table-panel">
        <table class="gwios-table">
            <thead>
                <tr>
                    <th scope="col">Zeitstempel</th>
                    <th scope="col">Level</th>
                    <th scope="col">Nachricht</th>
                </tr>
            </thead>
            <tbody>
                @foreach (LogEntry entry in _page.Entries)
                {
                    <tr @key="entry.Id"
                        class="gwios-log-row"
                        tabindex="0"
                        title="Details anzeigen"
                        aria-haspopup="dialog"
                        @onclick="() => OpenEntry(entry)"
                        @onkeydown="eventArgs => OpenEntryOnEnter(eventArgs, entry)">
                        <td data-label="Zeitstempel" class="gwios-table-secondary">
                            <GwiOSTimestamp Value="entry.Timestamp" />
                        </td>
                        <td data-label="Level"><GwiOSLogLevelBadge Level="entry.LogLevel" /></td>
                        <td data-label="Nachricht" class="gwios-log-message">@ShortenMessage(entry.Message)</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_page.TotalCount == 0)
        {
            <p class="gwios-empty">Keine Log-Einträge für diese Auswahl.</p>
        }
        <GwiOSPager TotalCount="_page.TotalCount"
                    PageNumber="_pageNumber"
                    PageNumberChanged="ChangePageAsync"
                    PageSize="_pageSize"
                    PageSizeChanged="ChangePageSizeAsync" />
    </div>
</div>

@if (_openedEntry is not null)
{
    <GwiOSDialog Title="Log-Eintrag" OnClose="CloseEntry">
        <HeaderContent>
            <GwiOSLogLevelBadge Level="_openedEntry.LogLevel" IsLarge="true" />
        </HeaderContent>
        <ChildContent>
            <GwiOSLogEntryDetails Entry="_openedEntry" />
        </ChildContent>
    </GwiOSDialog>
}
