@page "/haushaltsbuch/berichte"

<PageTitle>Berichte · Haushaltsbuch · gwi-os</PageTitle>

<div class="gwios-page">
    <h1>Haushaltsbuch</h1>

    <div class="gwios-stack gwios-stack--compact">
        <div class="gwios-toolbar-panel">
            <span class="gwios-berichte-toolbar-label">Zeitraum</span>
            <GwiOSPillGroup Items="RangeItems"
                            SelectedItem="@SelectedRangeItem"
                            SelectedItemChanged="SelectRangeAsync"
                            AriaLabel="Zeitraum"
                            Variant="GwiOSPillGroupVariant.Toggles" />
            <span class="gwios-berichte-toolbar-info">@RangeInfo</span>
        </div>

        <div class="gwios-berichte-grid">
            <GwiOSCard Title="Soll / Ist"
                       Hint="Geplante Fixkosten gegen tatsächliche Ausgaben"
                       IsEmpty="SollIstRows.Count == 0"
                       EmptyText="Keine Fixkosten oder Ausgaben in diesem Zeitraum.">
                <div class="gwios-berichte-legend">
                    <span class="gwios-berichte-legend-item">
                        <span class="gwios-berichte-legend-swatch gwios-berichte-legend-swatch--plan"></span>Plan
                    </span>
                    <span class="gwios-berichte-legend-item">
                        <span class="gwios-berichte-legend-swatch gwios-berichte-legend-swatch--actual"></span>Ist
                    </span>
                </div>
                <div class="gwios-soll-ist-rows">
                    @foreach (SollIstRow row in SollIstRows)
                    {
                        bool isOverPlan = row.Actual > row.Plan;
                        <div class="gwios-soll-ist-row">
                            <div class="gwios-soll-ist-row-header">
                                <span>@row.Label</span>
                                <span class="gwios-soll-ist-row-values">
                                    @FormatAmount(row.Plan) / <span class="@(isOverPlan ? "gwios-soll-ist-actual--over" : "gwios-soll-ist-actual--within")">@FormatAmount(row.Actual)</span>
                                </span>
                            </div>
                            <div class="gwios-soll-ist-bar">
                                <span class="gwios-soll-ist-bar-fill gwios-soll-ist-bar-fill--plan" style="width: @(row.PlanPercentage)%;"></span>
                            </div>
                            <div class="gwios-soll-ist-bar">
                                <span class="gwios-soll-ist-bar-fill @(isOverPlan ? "gwios-soll-ist-bar-fill--over" : "gwios-soll-ist-bar-fill--within")"
                                      style="width: @(row.ActualPercentage)%;"></span>
                            </div>
                        </div>
                    }
                </div>
            </GwiOSCard>

            <GwiOSCard Title="Ausgaben nach Kategorie"
                       Hint="@DonutHint"
                       IsEmpty="DonutSegments.Count == 0"
                       EmptyText="Keine Ausgaben in diesem Zeitraum.">
                <GwiOSDonutChart Segments="DonutSegments" OnSegmentClick="DrillIntoCategory" />
            </GwiOSCard>
        </div>

        <GwiOSCard Title="Monatsverlauf" Hint="Einnahmen gegen Ausgaben">
            <HeaderContent>
                <GwiOSLineChartLegend Series="LineSeries" />
            </HeaderContent>
            <ChildContent>
                <GwiOSLineChart Series="LineSeries" Labels="LineLabels" />
            </ChildContent>
        </GwiOSCard>

        <GwiOSCard Title="Fixkosten-Prognose" Hint="@ForecastHint">
            <HeaderContent>
                @* A plain link, so the browser handles the download itself; "download" keeps Blazor from routing it. *@
                <a class="gwios-button gwios-button--compact"
                   href="api/haushaltsbuch/fixkosten-prognose"
                   download
                   data-enhance-nav="false">
                    Als PDF herunterladen
                </a>
            </HeaderContent>
            <ChildContent>
                <div class="gwios-berichte-forecast">
                    @foreach (RecurringItemForecastMonth month in _forecastMonths)
                    {
                        <GwiOSRecurringItemForecastMonth @key="month.Month" Month="month" Categories="_categories" />
                    }
                </div>
            </ChildContent>
        </GwiOSCard>
    </div>
</div>
